# Calibration only (see calibrate.py): alert on EVERY matching packet, no threshold, so the EVE file records the true
# per-source packet / SYN rate of whatever traffic is driven at the tap. Never used in the normal lab.
alert udp any any -> any 5300 (msg:"CAL udp"; dsize:>0; classtype:attempted-dos; sid:2000002; rev:1;)
alert tcp any any -> any 9000 (msg:"CAL tcp syn"; flags:S; classtype:attempted-dos; sid:2000003; rev:1;)
alert tcp any any -> any 8000 (msg:"CAL web syn"; flags:S; classtype:attempted-dos; sid:2000001; rev:1;)
alert tcp any any -> any 8000 (msg:"CAL web small payload"; flow:established,to_server; dsize:1<>61; classtype:attempted-dos; sid:2000004; rev:1;)
alert http any any -> any 8080 (msg:"CAL ingress http request"; flow:established,to_server; http.method; content:"GET"; classtype:attempted-dos; sid:2000005; rev:1;)
